{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build opencv",
            "type": "shell",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe", // for running code through MSYS2 MinGW x64
            "args": [
                "-g",
                "${file}",
                "-std=c++17",
                "`C:\\msys64\\mingw64\\bin\\pkg-config.exe --cflags --libs opencv4`",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
